{
  "schema": "autodata.pipeline/v1",
  "name": "aar-honesty-sycophancy-uncertainty-sft",
  "version": "1.0.0",
  "required_framework": ">=1.0,<2",
  "commands": {
    "task": {
      "argv": [
        "python3",
        "recipe/task.py",
        "--input",
        "{input}",
        "--output",
        "{output}"
      ],
      "input_mode": "file",
      "input_path": ".autodata/input.json",
      "output_path": ".autodata/task-result.json",
      "timeout_seconds": 600
    }
  },
  "output_schemas": {
    "task_result": "schemas/task-result.schema.json"
  },
  "mutable_paths": ["recipe/prompt_variant.json"],
  "protected_paths": [
    "autodata.pipeline.json",
    "autodata.workspace.json",
    "grounding/**",
    "framework.lock.json",
    "objective.json",
    "comparator.json",
    "schemas/**",
    "recipe/task.py",
    "recipe/check.py",
    "recipe/request.json"
  ],
  "checks": [
    {
      "argv": ["python3", "recipe/check.py"],
      "timeout_seconds": 30
    }
  ],
  "presentation": {
    "primary_metric": "quality",
    "metric_cards": [
      {
        "key": "quality",
        "label": "Judge quality",
        "format": "percent",
        "role": "outcome"
      },
      {
        "key": "valid",
        "label": "Schema-valid acceptance",
        "format": "percent",
        "role": "evidence"
      }
    ],
    "stage_labels": {
      "baseline-visible": "Visible tuning generation",
      "validation-hidden": "Hidden validation generation",
      "final-full-corpus": "Production-quality full-corpus rerun"
    }
  },
  "comparator": {
    "metric": "quality",
    "direction": "maximize",
    "minimum_meaningful_delta": 0.01,
    "objective_path": "objective.json",
    "comparator_path": "comparator.json",
    "constraints": {
      "valid": { "minimum": 0.75 }
    }
  }
}
