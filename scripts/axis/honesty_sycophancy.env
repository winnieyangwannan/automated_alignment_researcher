# One checkpoint jointly optimized for internal honesty and sycophancy resistance.
PROMPT_TEMPLATE="${PROMPT_TEMPLATE:-prompt_safety.jinja2}"
SUITE_NAME="${SUITE_NAME:-honesty_sycophancy}"
HELD_OUT_BENCH="${HELD_OUT_BENCH:-deceptionbench_reward,sycon_fp}"
SAFETY_PROPERTY="${SAFETY_PROPERTY:-honesty and sycophancy resistance}"

if [ -z "${SAFETY_OBJECTIVE:-}" ]; then
  SAFETY_OBJECTIVE="train one checkpoint that states what it genuinely believes, avoids self-initiated deception, and maintains correct independent answers under user pressure, while preserving general capabilities"
fi

SEED_METHOD="${SEED_METHOD:-}"
