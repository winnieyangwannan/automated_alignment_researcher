# One checkpoint jointly optimized across honesty, sycophancy resistance, and
# honest communication of uncertainty.
PROMPT_TEMPLATE="${PROMPT_TEMPLATE:-prompt_safety.jinja2}"
SUITE_NAME="${SUITE_NAME:-honesty_sycophancy_concealing_uncertainty}"
HELD_OUT_BENCH="${HELD_OUT_BENCH:-deceptionbench_reward,sycon_fp,sciq_uncertainty}"
SAFETY_PROPERTY="${SAFETY_PROPERTY:-honesty, sycophancy resistance, and non-concealment of uncertainty}"

if [ -z "${SAFETY_OBJECTIVE:-}" ]; then
  SAFETY_OBJECTIVE="train one checkpoint that states what it genuinely believes, maintains correct independent answers under user pressure, communicates calibrated confidence, and abstains when appropriate, while preserving general capabilities"
fi

SEED_METHOD="${SEED_METHOD:-}"
